<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Boto_da_Fortuna.MainPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Padding="0"
             BackgroundColor="Transparent">
    <Grid>

        <Image Source="cenariojogo.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid>
            <ImageButton Source="voltar.png"
                         Clicked="OnVoltarClicked"
                         HeightRequest="60"
                         WidthRequest="60"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Start"
                         VerticalOptions="Start"
                         Margin="10" />

            <ScrollView>
                <VerticalStackLayout Spacing="5" Padding="0" VerticalOptions="Center">

                    <!-- Container da roleta: aumenta tamanho e adiciona margem superior para evitar corte -->
                    <Grid WidthRequest="300" HeightRequest="450"
                          HorizontalOptions="Center" VerticalOptions="Center"
                          Margin="0,2,0,0"> <!-- margem topo para não colar na barra do SO -->
                        <!-- IMAGEM DE FUNDO DA ROLETA: AspectFit para não cortar -->
                        <Image Source="niquel.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="-50" />

                        <!-- GRADE COM OS SLOTS (fundo transparente) -->
                        <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" Padding="10" RowSpacing="-100" ColumnSpacing="10"
                              BackgroundColor="Transparent">
                            <Image x:Name="Slot1" Source="item1.png" Aspect="AspectFit" BackgroundColor="Transparent"/>
                            <Image x:Name="Slot2" Source="item2.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Column="1"/>
                            <Image x:Name="Slot3" Source="item1.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Column="2"/>

                            <Image x:Name="Slot4" Source="item2.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Row="1"/>
                            <Image x:Name="Slot5" Source="item1.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="1"/>
                            <Image x:Name="Slot6" Source="item3.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Row="1" Grid.Column="2"/>

                            <Image x:Name="Slot7" Source="item3.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Row="2"/>
                            <Image x:Name="Slot8" Source="item1.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Row="2" Grid.Column="1"/>
                            <Image x:Name="Slot9" Source="item2.png" Aspect="AspectFit" BackgroundColor="Transparent" Grid.Row="2" Grid.Column="2"/>
                        </Grid>
                    </Grid>

                    <!-- resto -->
                    <Label x:Name="LblSaldo" Text="Saldo: R$ 0,00" TextColor="White" FontSize="24" HorizontalOptions="Center" />

                    <ImageButton Source="botao_spin.png" Clicked="OnApostarClicked"
                                 HeightRequest="70" WidthRequest="150" BackgroundColor="Transparent"
                                 HorizontalOptions="Center" Margin="10"/>

                    <Label x:Name="LblAlerta" Text="" TextColor="#FF6B6B" FontSize="18"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
