<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Boto_da_Fortuna.MainPage"
             BackgroundColor="#004D40">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Label Text="FORTUNE BOTO"
                   TextColor="#FFD700" FontSize="32" FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Image Source="imgboto.jpg"
                   HeightRequest="120" HorizontalOptions="Center" />

            <Border Stroke="#FFD700" StrokeThickness="4" BackgroundColor="#222"
                    WidthRequest="300" HeightRequest="300"
                    HorizontalOptions="Center">
                <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" Padding="10" RowSpacing="5" ColumnSpacing="5">

                    <Image x:Name="Slot1" Source="item1.png" Aspect="AspectFit" BackgroundColor="White"/>
                    <Image x:Name="Slot2" Source="item2.png" Aspect="AspectFit" BackgroundColor="White" Grid.Column="1"/>
                    <Image x:Name="Slot3" Source="item1.png" Aspect="AspectFit" BackgroundColor="White" Grid.Column="2"/>

                    <Image x:Name="Slot4" Source="item2.png" Aspect="AspectFit" BackgroundColor="White" Grid.Row="1"/>
                    <Image x:Name="Slot5" Source="item1.png" Aspect="AspectFit" BackgroundColor="White" Grid.Row="1" Grid.Column="1"/>
                    <Image x:Name="Slot6" Source="item3.png" Aspect="AspectFit" BackgroundColor="White" Grid.Row="1" Grid.Column="2"/>

                    <Image x:Name="Slot7" Source="item3.png" Aspect="AspectFit" BackgroundColor="White" Grid.Row="2"/>
                    <Image x:Name="Slot8" Source="item1.png" Aspect="AspectFit" BackgroundColor="White" Grid.Row="2" Grid.Column="1"/>
                    <Image x:Name="Slot9" Source="item2.png" Aspect="AspectFit" BackgroundColor="White" Grid.Row="2" Grid.Column="2"/>

                </Grid>
            </Border>

            <Label x:Name="LblSaldo"
                   Text="Saldo: R$ 1000,00"
                   TextColor="White" FontSize="24" HorizontalOptions="Center" />

            <Button x:Name="BtnApostar"
                    Text="GIRAR (R$ 10,00)"
                    Clicked="OnApostarClicked"
                    BackgroundColor="#FFD700" TextColor="Black" FontAttributes="Bold"
                    HeightRequest="50" CornerRadius="25" HorizontalOptions="Center" />

            <Button Text="PARAR (SAIR)"
                    Clicked="OnPararClicked"
                    BackgroundColor="#D32F2F" TextColor="White" FontAttributes="Bold"
                    HeightRequest="50" CornerRadius="25" HorizontalOptions="Center" />

            <Label x:Name="LblAlerta"
                   Text=""
                   TextColor="#FF6B6B" FontSize="18"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>